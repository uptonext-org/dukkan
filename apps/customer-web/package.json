{
  "name": "dukkan-customer-web",
  "version": "0.1.0",
  "private": true,
  "description": "Dukkan for the browser: the customer app (apps/mobile) built with react-native-web and web adapters for storage, photos, speech, video frames and the map.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview --port 5175 --strictPort",
    "dev": "vite build && vite preview --port 5175 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react-dom": "19.3.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/leaflet": "1.9.22",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.22.0"
  }
}
