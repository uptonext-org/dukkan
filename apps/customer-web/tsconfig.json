{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "react": [
        "../mobile/node_modules/@types/react"
      ],
      "react/*": [
        "../mobile/node_modules/@types/react/*"
      ],
      "react-native": [
        "../mobile/node_modules/react-native/types_generated/index.d.ts"
      ],
      "react-native-web": [
        "./src/shims/react-native-web.d.ts"
      ]
    },
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "src"
  ]
}
