# Production settings for compose.yaml. Copy to .env on the server; never commit the real file.
# Every value marked REQUIRED must be set; the backend refuses to start with development defaults.

# --- Release ------------------------------------------------------------------------------
DUKKAN_IMAGE_PREFIX=ghcr.io/uptonext-org
# REQUIRED, the release tag without "v", e.g. 1.0.0
DUKKAN_VERSION=

# --- Domains (DNS must point at this server) ----------------------------------------------
# REQUIRED, customers, e.g. dukkan.de
DUKKAN_DOMAIN=
# REQUIRED, merchants and admins, e.g. haendler.dukkan.de
DUKKAN_PORTAL_DOMAIN=
# REQUIRED, Let's Encrypt contact
DUKKAN_ACME_EMAIL=

# --- Secrets ------------------------------------------------------------------------------
# REQUIRED, openssl rand -base64 32
POSTGRES_PASSWORD=
# REQUIRED, openssl rand -base64 48
DUKKAN_JWT_SECRET=

# --- Mail (password reset, e-mail verification) -------------------------------------------
# REQUIRED, e.g. smtp.eu.mailgun.org / smtp-relay.brevo.com
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# REQUIRED, a sender of your domain (SPF/DKIM set up)
DUKKAN_MAIL_FROM=Dukkan <no-reply@example.org>

# --- Legal and payment (GET /platform) ----------------------------------------------------
# e.g. https://dukkan.de/impressum.html
DUKKAN_IMPRINT_URL=
DUKKAN_PRIVACY_URL=
DUKKAN_TERMS_URL=
# e.g. 2026-11; new accounts must accept it
DUKKAN_TERMS_VERSION=
DUKKAN_SUPPORT_EMAIL=
# customers pay the market at pickup/delivery
DUKKAN_PAYMENT=ON_SITE

# --- First admin: register this account in the app, then restart once with it set --------
DUKKAN_BOOTSTRAP_ADMIN_EMAIL=

# --- Optional -----------------------------------------------------------------------------
# AI capture, translation, shopping lists (DPA first)
DUKKAN_ANTHROPIC_API_KEY=
# markets wait for an admin's review
DUKKAN_MERCHANT_AUTO_APPROVE=false
# no orders before the e-mail address is confirmed
DUKKAN_REQUIRE_VERIFIED_EMAIL=true
# tile provider with a contract, see apps/customer-web/README.md
DUKKAN_MAP_TILE_URL=
DUKKAN_MAP_ATTRIBUTION=
# push (with a service account file, see docs/setup.md)
DUKKAN_FCM_PROJECT_ID=
DUKKAN_FCM_CREDENTIALS_FILE=
BACKUP_KEEP_DAYS=14
