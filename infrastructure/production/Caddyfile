# TLS certificates from Let's Encrypt, renewed by Caddy. DNS A/AAAA records of both domains must
# point at this server before the first start.
{
	email {$DUKKAN_ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# The API: uploads up to 21 MB (four shopping-list photos).
	handle /api/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy backend:8080
	}
	# Never public: the actuator runs on the backend's management port only.
	handle /actuator/* {
		respond 404
	}
}

# Customers: the web app, and the links in mails (/reset-password, /verify-email).
{$DUKKAN_DOMAIN} {
	import common
	handle {
		reverse_proxy web:8080
	}
}

# Merchants and admins.
{$DUKKAN_PORTAL_DOMAIN} {
	import common
	handle {
		reverse_proxy portal:8080
	}
}
